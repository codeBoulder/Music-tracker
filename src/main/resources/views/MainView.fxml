<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="prog.controllers.MainController"
            prefWidth="900" prefHeight="650"
            styleClass="root-pane">

    <top>
        <VBox styleClass="header">
            <Label text="🎵 Music Collection Manager" styleClass="header-title"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">

            <Tab text="🎵  Всі треки">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

                    <HBox spacing="8" styleClass="toolbar">
                        <Button text="➕ Додати трек"    onAction="#onAddTrack"    styleClass="btn-primary"/>
                        <Button text="✏️ Редагувати"     onAction="#onEditTrack"   styleClass="btn-secondary"/>
                        <Button text="🗑️ Видалити"       onAction="#onDeleteTrack" styleClass="btn-danger"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Тривалість (сек):" styleClass="search-label"/>
                        <TextField fx:id="minDurField" promptText="від" prefWidth="60" styleClass="search-field"/>
                        <Label text="—" styleClass="search-dash"/>
                        <TextField fx:id="maxDurField" promptText="до"  prefWidth="60" styleClass="search-field"/>
                        <Button text="🔍 Знайти"  onAction="#onSearchByDuration" styleClass="btn-search"/>
                        <Button text="✖ Скинути"  onAction="#onClearSearch"      styleClass="btn-reset"/>
                    </HBox>

                    <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <placeholder>
                            <Label text="Треків ще немає. Додайте перший!"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colTrackId"       text="#"          prefWidth="45"  style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colTrackTitle"    text="Назва"      prefWidth="220"/>
                            <TableColumn fx:id="colTrackArtist"   text="Виконавець" prefWidth="180"/>
                            <TableColumn fx:id="colTrackGenre"    text="Жанр"       prefWidth="110" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colTrackDuration" text="Тривалість" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="💿  Диски / Збірки">
                <VBox spacing="10" styleClass="tab-content">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

                    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.38" styleClass="disc-split">

                        <VBox spacing="8" styleClass="disc-left-panel" minWidth="260">
                            <padding><Insets top="0" right="6" bottom="0" left="0"/></padding>

                            <HBox spacing="6" styleClass="toolbar">
                                <Button text="➕ Новий диск"  onAction="#onCreateDisc" styleClass="btn-primary"/>
                                <Button text="✏️ Змінити"     onAction="#onEditDisc"   styleClass="btn-secondary"/>
                                <Button text="🗑️ Видалити"    onAction="#onDeleteDisc" styleClass="btn-danger"/>
                            </HBox>

                            <TableView fx:id="discsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                                <placeholder>
                                    <Label text="Дисків ще немає"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="colDiscId"    text="#"     prefWidth="40" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colDiscTitle" text="Назва диска" prefWidth="200"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox spacing="8" styleClass="disc-right-panel" minWidth="400">
                            <padding><Insets top="0" right="0" bottom="0" left="6"/></padding>

                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
                                <Label text="Треки диска:" styleClass="section-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="🔀 Сортувати за жанром" onAction="#onSortByGenre" styleClass="btn-sort"/>
                            </HBox>

                            <TableView fx:id="discTracksTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                                <placeholder>
                                    <Label text="Оберіть диск зліва"/>
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="colDtTitle"    text="Назва"      prefWidth="180"/>
                                    <TableColumn fx:id="colDtArtist"   text="Виконавець" prefWidth="150"/>
                                    <TableColumn fx:id="colDtGenre"    text="Жанр"       prefWidth="90"  style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colDtDuration" text="Тривалість" prefWidth="90"  style="-fx-alignment: CENTER;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                            <HBox styleClass="duration-bar" alignment="CENTER_RIGHT">
                                <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                                <Label fx:id="totalDurationLabel" text="Загальна тривалість: —"
                                       styleClass="duration-label"/>
                            </HBox>
                        </VBox>

                    </SplitPane>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
            <Label text="Music Collection Manager v1.0  |  SQLite" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>