<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="prog.controllers.TrackDialogController"
      spacing="0" styleClass="dialog-root"
      prefWidth="420">

    <Label text="Дані треку" styleClass="dialog-header"/>

    <GridPane hgap="10" vgap="12" styleClass="dialog-form">
        <padding><Insets top="18" right="20" bottom="10" left="20"/></padding>

        <Label text="Назва *" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="titleField" promptText="Введіть назву треку"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>

        <Label text="Виконавець *" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="artistField" promptText="Ім'я виконавця або гурту"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>

        <Label text="Тривалість (сек) *" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="durationField" promptText="напр. 213"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>

        <Label text="Жанр *" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
        <ComboBox fx:id="genreCombo" maxWidth="Infinity"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"
                  GridPane.hgrow="ALWAYS"/>

        <Label fx:id="extraLabel" text="Піджанр:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>

        <TextField fx:id="extraField" promptText="Деталі жанру"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"
                   GridPane.hgrow="ALWAYS" maxWidth="Infinity"/>

        <CheckBox fx:id="hasVideoCheckBox" text="Так"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"
                  visible="false" managed="false"/>

        <Label text="* — обов'язкові поля" GridPane.rowIndex="5" GridPane.columnIndex="0"
               GridPane.columnSpan="2" styleClass="hint-label"/>
    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <padding><Insets top="12" right="20" bottom="14" left="20"/></padding>
        <Button text="Скасувати" onAction="#onCancel" styleClass="btn-cancel"  cancelButton="true"/>
        <Button text="💾 Зберегти" onAction="#onSave"  styleClass="btn-save"  defaultButton="true"/>
    </HBox>

</VBox>